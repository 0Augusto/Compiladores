; Function Attrs: nofree nosync nounwind ssp memory(none) uwtable(sync)
define i64 @fib(i64 noundef %0) local_unnamed_addr #0 {
  %2 = icmp ult i64 %0, 2
  br i1 %2, label %13, label %3

3:                                                ; preds = %3, %1
