  %6 = load ptr, ptr %5, align 8, !tbaa !5
  %7 = tail call i32 @atoi(ptr nocapture noundef %6)
  %8 = sext i32 %7 to i64
  br label %9

9:                                                ; preds = %4, %2
  %10 = phi i64 [ %8, %4 ], [ 43, %2 ]
  %11 = tail call i64 @fib(i64 noundef %10)
  %12 = tail call i32 (ptr, ...) @printf(ptr noundef nonnull dereferenceable(1) @.str, i64 noundef %11)
  ret i32 0
}

