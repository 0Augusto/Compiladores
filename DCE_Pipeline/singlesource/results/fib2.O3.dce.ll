  %5 = phi i64 [ %9, %3 ], [ 0, %1 ]
  %6 = add i64 %4, -2
  %7 = tail call i64 @fib(i64 noundef %6)
  %8 = add i64 %4, -1
  %9 = add i64 %7, %5
  %10 = icmp ult i64 %4, 3
  br i1 %10, label %11, label %3

11:                                               ; preds = %3
  %12 = add i64 %9, 1
  br label %13

13:                                               ; preds = %11, %1
  %14 = phi i64 [ 1, %1 ], [ %12, %11 ]
  ret i64 %14
}

; Function Attrs: nofree nounwind ssp uwtable(sync)
define noundef i32 @main(i32 noundef %0, ptr nocapture noundef readonly %1) local_unnamed_addr #1 {
